# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# Local dev without Docker: `npx prisma dev` gives you a connection string.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/litigaia?schema=public"

# ---------------------------------------------------------------------------
# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
# ---------------------------------------------------------------------------
AUTH_SECRET=""

# OAuth providers (optional — omit to hide the corresponding login button's
# functionality; the buttons still render)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Resend — transactional email (magic links, welcome email, claim copies)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
AUTH_RESEND_KEY=""
EMAIL_FROM="Litiga IA <no-reply@litiga-ia.com>"

# ---------------------------------------------------------------------------
# AI provider — switch engines without touching call sites.
# AI_PROVIDER = "mock" | "openai" | "anthropic"
# "mock" (default) needs no API key and is fully functional for local dev/demo.
# ---------------------------------------------------------------------------
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Stripe — billing
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# ---------------------------------------------------------------------------
# UploadThing — claim attachment uploads
# ---------------------------------------------------------------------------
UPLOADTHING_TOKEN=""
