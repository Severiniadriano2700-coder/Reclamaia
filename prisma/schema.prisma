generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

enum ClaimCategory {
  AIRLINE
  BANK
  ECOMMERCE
  HOTEL
  INSURANCE
  TRANSPORT
  TELECOM
  RETAIL
  PUBLIC_ADMINISTRATION
  OTHER
}

enum ClaimStatus {
  DRAFT
  GENERATING
  GENERATED
  EDITED
  SENT
  RESOLVED
  REJECTED
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  MOCK
}

enum ChatRole {
  USER
  ASSISTANT
}

// ---------- Auth.js models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  claims       Claim[]
  templates    Template[]
  subscription Subscription?
  invoices     Invoice[]
  usageRecords UsageRecord[]
  auditLogs    AuditLog[]
  chatMessages ChatMessage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------- Domain models ----------

model Company {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  category       ClaimCategory
  logoUrl        String?
  complaintEmail String?
  website        String?
  createdAt      DateTime      @default(now())

  claims Claim[]

  @@index([category])
  @@map("companies")
}

model Claim {
  id                String        @id @default(cuid())
  userId            String
  companyId         String?
  companyNameRaw    String?
  category          ClaimCategory
  title             String
  incidentDate      DateTime?
  description       String        @db.Text
  desiredOutcome    String        @db.Text
  claimantFirstName String?
  claimantLastName  String?
  claimantDni       String?
  claimantAddress   String?
  referenceNumber   String?
  claimedAmount     String?
  generatedContent  String?       @db.Text
  status            ClaimStatus   @default(DRAFT)
  aiProvider        AiProvider?
  aiModel           String?
  isFavorite        Boolean       @default(false)
  sentAt            DateTime?
  sentToEmail       String?
  requiresPayment      Boolean   @default(false)
  paidAt               DateTime?
  stripePaymentIntentId String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  company      Company?      @relation(fields: [companyId], references: [id])
  files        ClaimFile[]
  chatMessages ChatMessage[]

  @@index([userId])
  @@index([status])
  @@map("claims")
}

model ClaimFile {
  id        String   @id @default(cuid())
  claimId   String
  url       String
  name      String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@map("claim_files")
}

model Template {
  id        String        @id @default(cuid())
  userId    String?
  name      String
  category  ClaimCategory
  content   String        @db.Text
  isPublic  Boolean       @default(false)
  createdAt DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("templates")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  trialEnd             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Invoice {
  id               String   @id @default(cuid())
  userId           String
  stripeInvoiceId  String   @unique
  amountPaid       Int
  currency         String   @default("eur")
  status           String
  pdfUrl           String?
  hostedInvoiceUrl String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model UsageRecord {
  id              String   @id @default(cuid())
  userId          String
  periodStart     DateTime
  periodEnd       DateTime
  claimsGenerated Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@map("usage_records")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  claimId   String?
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  claim Claim? @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([claimId])
  @@map("chat_messages")
}
